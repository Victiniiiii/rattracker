{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-capability",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"dialog:default",
		"fs:allow-appconfig-read",
		"fs:allow-appconfig-write",
        "fs:allow-exists",
		{
			"identifier": "fs:allow-exists",
			"allow": [{ "path": "$APPCONFIG/*" }]
		}
	]
}
