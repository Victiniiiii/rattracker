{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "morriswatermazeanalysis",
	"version": "1.0.0",
	"identifier": "com.morriswatermazeanalysis.morriswatermazeanalysis",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Morris Water Maze Analysis",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["bin/main"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
